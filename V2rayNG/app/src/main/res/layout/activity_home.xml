<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- no subscription yet -->
        <LinearLayout
            android:id="@+id/card_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView style="@style/EthaTitle" android:text="@string/etha_empty_title" />
            <TextView style="@style/EthaBody" android:layout_marginTop="6dp" android:text="@string/etha_empty_hint" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_paste"
                style="@style/EthaPrimaryButton"
                android:layout_marginTop="18dp"
                android:text="@string/etha_paste_link" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:textColor="@color/etha_blue_light"
                android:text="@string/etha_scan_qr" />
        </LinearLayout>

        <!-- the hero: the glowing Connect button, the state, one line under it. It takes the height the phone has
             to spare (the weight; the ScrollView fills the viewport), with its block in the middle, so the last
             button sits at the bottom of the screen on every phone; HomeActivity grows the disc with that height. -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

          <LinearLayout
              android:id="@+id/hero_block"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:clipChildren="false"
              android:gravity="center_horizontal"
              android:orientation="vertical">

            <FrameLayout
                android:id="@+id/ring"
                android:layout_width="204dp"
                android:layout_height="204dp">

                <View
                    android:id="@+id/halo"
                    android:layout_width="204dp"
                    android:layout_height="204dp"
                    android:background="@drawable/bg_halo_blue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_connect"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/etha_connect"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="75dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_power_48dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="58dp"
                    app:iconTint="@color/colorWhite" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_state"
                style="@style/EthaHeadline"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/etha_state_not_connected" />

            <!-- one of three under the state — the hint, the chip, the spinner — in a slot as tall as the hint's two
                 lines whatever it shows (the hint goes invisible, never gone): the block keeps its height, so the
                 Connect button does not move when the state changes -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_connect_hint"
                style="@style/EthaMuted"
                android:layout_width="match_parent"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.35"
                android:minLines="2"
                android:textSize="13sp"
                android:text="@string/etha_tap_to_connect" />

            <TextView
                android:id="@+id/tv_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip"
                android:drawableStart="@drawable/bg_dot"
                android:drawablePadding="6dp"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/etha_green_light"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/etha_blue_light"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />
            </FrameLayout>
          </LinearLayout>
        </LinearLayout>

        <!-- the server panel: tap → the sheet -->
        <LinearLayout
            android:id="@+id/panel_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/EthaLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/etha_server" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test"
                    style="@style/EthaLinkButton"
                    android:text="@string/etha_test_again" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tv_server_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_server_ms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/vazirmatn"
                    android:textColor="@color/etha_green_light"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right_20dp"
                    app:tint="@color/etha_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- the account tiles -->
        <LinearLayout
            android:id="@+id/card_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/EthaTile">
                    <TextView android:id="@+id/tv_days" style="@style/EthaTileValue" />
                    <TextView android:id="@+id/tv_days_label" style="@style/EthaTileLabel" />
                </LinearLayout>

                <Space android:layout_width="10dp" android:layout_height="1dp" />

                <LinearLayout style="@style/EthaTile">
                    <TextView android:id="@+id/tv_data" style="@style/EthaTileValue" />
                    <TextView android:id="@+id/tv_data_label" style="@style/EthaTileLabel" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/data_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/etha_blue_light"
                        app:trackColor="@color/etha_track"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="4dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_announce"
                style="@style/EthaBody"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_announce"
                android:padding="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/tv_updated"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/vazirmatn"
                    android:textColor="@color/etha_muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refresh"
                    style="@style/EthaPill"
                    app:icon="@drawable/ic_refresh_16dp"
                    android:text="@string/etha_refresh" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_renew"
                    style="@style/EthaPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/etha_renew" />

                <Space android:layout_width="10dp" android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_support"
                    style="@style/EthaOutlinedButton"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/etha_support" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_update"
            style="@style/EthaBody"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_announce"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
