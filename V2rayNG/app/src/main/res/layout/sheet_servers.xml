<?xml version="1.0" encoding="utf-8"?>
<!-- 3.0.0: the Servers sheet — Auto and every country the box offers, each with its measured latency; one button (HomeActivity.openServers) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_grab" />

    <TextView
        style="@style/EthaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/etha_server_pick" />

    <LinearLayout
        android:id="@+id/exit_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_exit_go"
        style="@style/EthaPrimaryButton"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="0dp"
        android:text="@string/etha_server_connect" />
</LinearLayout>
