<?xml version="1.0" encoding="utf-8"?>
<!-- 3.0.0: the Servers sheet — Auto and every country the box offers, each with its measured latency; one button (HomeActivity.openServers).
     The rows scroll and the button stays under them: with eleven countries the plain column was taller than most screens and the
     button was never on them (3.0.2). 3.0.4: the list's height is the layout's own business, never a number worked out from the
     screen — the scroll view carries a weight, so when the column is taller than what Material's sheet gives it (the window less
     the status and the navigation bar, whatever they are on this Android), LinearLayout takes the excess off the list and nothing
     else, and a shorter list keeps its own height. 3.0.3 set the height from Configuration.screenHeightDp, which includes both
     bars on Android 15 and later for an app that targets it: the button was cut off again there. Seen on emulators by
     ServersSheetTest (the workflow's ui-test job) before a release carries it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_grab" />

    <TextView
        style="@style/EthaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/etha_server_pick" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/exit_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fadingEdgeLength="24dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/exit_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_exit_go"
        style="@style/EthaPrimaryButton"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="0dp"
        android:text="@string/etha_server_connect" />
</LinearLayout>
